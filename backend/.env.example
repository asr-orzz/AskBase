# Application
APP_NAME=RAGOps
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ragops:ragops@localhost:5432/ragops
DATABASE_SYNC_URL=postgresql://ragops:ragops@localhost:5432/ragops

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ragops
S3_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google
GOOGLE_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ragops-backend

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
